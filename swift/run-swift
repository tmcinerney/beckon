#!/usr/bin/env bash
set -euo pipefail
# Reused from the native prototype: use Xcode's SDK, not Nix's Rust/C SDK.
unset SDKROOT DEVELOPER_DIR
export DEVELOPER_DIR="$(/usr/bin/xcode-select -p)"
export SDKROOT="$(/usr/bin/xcrun --sdk macosx --show-sdk-path)"
package_dir="$(cd "$(dirname "$0")" && pwd)"
if [[ "${1:-}" == run ]]; then
  shift
  exec /usr/bin/xcrun swift run --package-path "$package_dir" --sdk "$SDKROOT" "$@"
fi
exec /usr/bin/xcrun swift "$@" --package-path "$package_dir" --sdk "$SDKROOT"
